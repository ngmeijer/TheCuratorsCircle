{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firestore": {
    "DatabaseId": "the-curator-s-circle"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8081" ]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "WritePermitLimit": 10,
    "WriteWindowSeconds": 60
  }
}
